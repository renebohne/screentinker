<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      3.0 "Share my screen" (share/): the capture runs in a foreground service of type mediaProjection,
      whose notification says where the screen is going and has Stop. Android asks the person to allow
      the capture every time (MediaProjection); there is no permission that skips that.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- libwebrtc's audio module is created (no audio is ever sent: the share is the picture only). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Custom Tabs: "Advanced", Admin and outside links open in the phone's browser. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!--
      networkSecurityConfig: the server is whatever the user types, and a self-hosted ScreenTinker on a
      LAN is often plain http://192.168.x.y:3001. screentinker.com itself is HTTPS-only.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Manager">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share my screen" (res/xml/shortcuts.xml). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- "Share to ScreenTinker Manager" from the Gallery or Photos. -->
            <!-- Single sign-on comes back here from the browser (SsoHandoff). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="screentinker-manager" android:host="sso" />
            </intent-filter>
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ServerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          3.0 "Share my screen" without an account (share/GuestShareActivity). The server and the code
          come from the link; the screen shows "Share your screen to <host>?" before anything is
          captured. A self-hosted server's domain can never be a verified App Link, so:
            - screentinker://share?server=…&code=…   the /share page's "Share my screen with the app"
                                                      (an intent: URL, Play Store when not installed)
            - http(s)://<any host>/share             the QR on a screen, if the person picks this app
                                                      (unverified: Android may simply open the browser,
                                                      whose /share page then offers the button above)
        -->
        <activity
            android:name=".share.GuestShareActivity"
            android:exported="true"
            android:label="@string/gs_title"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="screentinker" android:host="share" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="*" />
                <data android:path="/share" />
                <data android:path="/share/" />
            </intent-filter>
        </activity>

        <service
            android:name=".share.ShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
