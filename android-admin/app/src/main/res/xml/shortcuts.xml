<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Share my screen" (no account needed; share/GuestShareActivity). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="share_screen"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/gs_shortcut">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.screentinker.manager"
            android:targetClass="com.screentinker.manager.share.GuestShareActivity" />
    </shortcut>
</shortcuts>
