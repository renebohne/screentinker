<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/server_title"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/server_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Saved servers (ServerActivity fills it); hidden on first run. -->
        <TextView
            android:id="@+id/savedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/servers_title"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/savedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/addTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/server_question"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/choiceHosted"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:text="@string/server_hosted"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/choiceOwn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/server_own"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="@string/server_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary"
            android:visibility="gone" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_bg"
            android:text="@string/server_connect"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- 3.0: present on a meeting-room screen without an account (share/GuestShareActivity). -->
        <Button
            android:id="@+id/shareScreen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/input_bg"
            android:text="@string/gs_entry_button"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/gs_entry_button_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
